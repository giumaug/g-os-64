BASE_DIR        =/home/peppe/Desktop/g-os-grub2/g-os-64
INCLUDE		=$(BASE_DIR)/include
MAKE 		= make
CC		= gcc 
LD		= ld

CFLAGS		= -O0 -gdwarf-4 -c -mno-red-zone -fno-builtin -fno-pie -mcmodel=large -fno-stack-protector -Wno-error=int-conversion -Wno-error=incompatible-pointer-types  -mno-sse
CPPFLAGS	=-I $(INCLUDE) 
